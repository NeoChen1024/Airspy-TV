{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "optimized-debug",
      "displayName": "Optimized debug",
      "description": "Debug symbols with production-like host-native DSP optimization and assertions disabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AIRSPY_TV_NATIVE_ARCH": "ON",
        "AIRSPY_TV_OPTIMIZED_DEBUG": "ON",
        "AIRSPY_TV_USE_SIMD_VITERBI": "ON"
      }
    },
    {
      "name": "assertion-debug",
      "displayName": "Assertion debug",
      "description": "Unoptimized assertion-enabled debug build for deterministic diagnostics",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AIRSPY_TV_NATIVE_ARCH": "ON",
        "AIRSPY_TV_OPTIMIZED_DEBUG": "OFF",
        "AIRSPY_TV_USE_SIMD_VITERBI": "ON"
      }
    },
    {
      "name": "portable-release",
      "displayName": "Portable release",
      "description": "Release build without host-native instructions or the optional SIMD Viterbi backend",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AIRSPY_TV_NATIVE_ARCH": "OFF",
        "AIRSPY_TV_OPTIMIZED_DEBUG": "OFF",
        "AIRSPY_TV_USE_SIMD_VITERBI": "OFF"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Address, undefined, and leak sanitizers",
      "description": "ASan and UBSan build with integrated LeakSanitizer and frame pointers",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AIRSPY_TV_NATIVE_ARCH": "OFF",
        "AIRSPY_TV_OPTIMIZED_DEBUG": "OFF",
        "AIRSPY_TV_USE_SIMD_VITERBI": "OFF",
        "CMAKE_C_FLAGS": "-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all",
        "CMAKE_CXX_FLAGS": "-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "Thread sanitizer",
      "description": "Standalone TSan build for repeated lifecycle and concurrency stress",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AIRSPY_TV_NATIVE_ARCH": "OFF",
        "AIRSPY_TV_OPTIMIZED_DEBUG": "OFF",
        "AIRSPY_TV_USE_SIMD_VITERBI": "OFF",
        "CMAKE_C_FLAGS": "-O1 -g -fno-omit-frame-pointer -fsanitize=thread",
        "CMAKE_CXX_FLAGS": "-O1 -g -fno-omit-frame-pointer -fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "optimized-debug",
      "configurePreset": "optimized-debug"
    },
    {
      "name": "assertion-debug",
      "configurePreset": "assertion-debug"
    },
    {
      "name": "portable-release",
      "configurePreset": "portable-release"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8,
        "noTestsAction": "error"
      }
    },
    {
      "name": "optimized-debug",
      "configurePreset": "optimized-debug",
      "inherits": "base"
    },
    {
      "name": "assertion-debug",
      "configurePreset": "assertion-debug",
      "inherits": "base"
    },
    {
      "name": "portable-release",
      "configurePreset": "portable-release",
      "inherits": "base"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "inherits": "base",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "inherits": "base",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error"
      }
    }
  ]
}
